# Copy this file to .env:  cp .env.example .env
# The defaults below work as-is with the local MongoDB from docker-compose.yml.

# --- Database: choose ONE option ---

# Option 1 (default): local MongoDB started with `docker compose up -d`.
# When MONGO_URI is set, the DB_* variables below are ignored.
MONGO_URI=mongodb://localhost:27017/language-power?replicaSet=rs0

# Option 2: MongoDB Atlas. Comment out MONGO_URI above and uncomment these.
# The app builds mongodb+srv://${DB_USER}:${DB_KEY}${DB_URL}/${DB_NAME}?retryWrites=true&w=majority
# so DB_URL must start with "@".
# DB_USER=your-db-user
# DB_KEY=your-db-password
# DB_URL=@your-cluster.example.mongodb.net
# DB_NAME=language-power

# --- Server ---
PORT=3000

# Frontend origin allowed by CORS
FE_ORIGIN=http://localhost:8080

# "dev" enables the signup route and error logging. Any other value disables signup.
mode=dev

# --- Auth ---
# Secret used to sign and verify JWT tokens. Use any long random string.
TOKEN_KEY=change-me

# bcrypt salt rounds used on signup
SALT_NUMBER=12

# --- Merriam-Webster Collegiate Dictionary API (https://dictionaryapi.com) ---
# MW_KEY is only needed for /api/words/search. /api/words/mocksearch works without it.
SEARCH_ENDPOINT=https://www.dictionaryapi.com/api/v3/references/collegiate/json
MW_KEY=your-merriam-webster-api-key
AUDIO_ENDPOINT=https://media.merriam-webster.com/soundc11

# --- Optional: Sentry error reporting (off when empty) ---
SENTRY_DSN=
